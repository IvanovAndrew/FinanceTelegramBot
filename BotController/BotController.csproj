<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
        <ContainerFamily>jammy-chiseled</ContainerFamily>
        <ContainerRepository>telegram-financebot-chiseled</ContainerRepository>
        <RootNamespace>TelegramBot</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="10.0.11" />
        <PackageReference Include="Refit" Version="15.2.0" />
        <PackageReference Include="Refit.HttpClientFactory" Version="15.2.0" />
        <PackageReference Include="Refit.Reflection" Version="15.2.0" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
        <PackageReference Include="Telegram.Bot" Version="22.10.3" />
        <PackageReference Include="Telegram.Bot.Extensions.Polling" Version="1.0.2" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="StateMachine\**" />
      <Compile Remove="Options.cs" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="StateMachine\**" />
    </ItemGroup>

    <ItemGroup>
      <Content Remove="StateMachine\**" />
      <Content Include="..\.dockerignore">
        <Link>.dockerignore</Link>
      </Content>
    </ItemGroup>

    <ItemGroup>
      <None Remove="StateMachine\**" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Application.Api\Application.Api.csproj" />
      <ProjectReference Include="..\Application.Bot\Application.Bot.csproj" />
      <ProjectReference Include="..\Application.Core\Application.Core.csproj" />
      <ProjectReference Include="..\Domain\Domain.csproj" />
      <ProjectReference Include="..\Infrastructure\Infrastructure.csproj" />
    </ItemGroup>

</Project>
